.container.m3
  h1.center  Test Sessions
  .card.m1
    h2.center Active Sessions
    - unless @active_test_sessions.empty?
      .table_overflow
        table
          tbody
            tr
              th ID
              th Title
              th Start Time
            - @active_test_sessions.each do |session|
              tr
                td=session.event_id
                td
                  a[href=url("/test_sessions/#{session.event_id}")]=session.title
                td=session.start_time.strftime("%B %e, %Y %H:%M %Z")
    - else
      p.center No active sessions.

  .card.m1
    h2.center Upcoming Sessions
    - unless @upcoming_test_sessions.empty?
      .table_overflow
        table
          tbody
            tr
              th ID
              th Title
              th Start Time
            - @upcoming_test_sessions.each do |session|
              tr
                td=session.event_id
                td
                  a[href=url("/test_sessions/#{session.event_id}")]=session.title
                td=session.start_time.strftime("%B %e, %Y %H:%M %Z")
    - else
      p.center No upcoming sessions.

  .card.m1
    h2.center Session Reports
    - unless @test_session_reports.empty?
      .table_overflow
        table
          tbody
            tr
              th ID
              th Title
              th Start Time
            - @test_session_reports.each do |session|
              tr
                  td=session.event_id
                  td
                    a[href=url("/test_sessions/#{session.event_id}")]=session.title
                  td=session.start_time.strftime("%B %e, %Y %H:%M %Z")
    - else
      p.center No reports available.

  .card.m1
    h2.center Testing Roster (#{W3DServerList::MemStore.data.dig(:tester_roster, :users)&.count || '?'})
    .table_overflow
      table
        tbody
          tr
            th Forum Name
            th Nickname
          - W3DServerList::MemStore.data.dig(:tester_roster, :users)&.each do |player|
            tr
              td=player[:name]
              td=player[:alternate]
